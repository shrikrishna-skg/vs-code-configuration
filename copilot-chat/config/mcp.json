{
  "servers": {
    "peekaboo": {
      "type": "stdio",
      "command": "<ABSOLUTE_PATH_TO_PEEKABOO>",
      "args": ["mcp", "serve", "--no-remote", "--transport", "stdio", "--allow-foreground"]
    },
    "claude-code-local": {
      "type": "stdio",
      "command": "<ABSOLUTE_PATH_TO_NODE>",
      "args": ["<ABSOLUTE_PATH_TO_KILO_CONFIG>/bridges/claude-cli-mcp.mjs"]
    }
  }
}
