{
  // VS Code 1.139 modern "connected" tabs paint the active tab with the editor background and
  // ignore classic tab.* colors. Pill style honors modernEditorTab.activeBackground; tab.activeBorder
  // drives the pill's bottom line and is kept dim on purpose.
  "workbench.experimental.modernUIEditorTabStyle": "pill",
  "workbench.colorCustomizations": {
    "modernEditorTab.activeBackground": "#3794ff26",
    "modernEditorTab.activeHoverBackground": "#3794ff33",
    "tab.activeBorder": "#3794ff59",
    "tab.unfocusedActiveBorder": "#3794ff33"
  },

  // Commands Kilo handles in the agent terminal rather than forwarding to the shell.
  "terminal.integrated.commandsToSkipShell": [
    "kilo-code.new.agentManagerOpen",
    "kilo-code.new.agentManager.showTerminal",
    "kilo-code.new.agentManager.previousTerminal",
    "kilo-code.new.agentManager.nextTerminal",
    "kilo-code.new.agentManager.runScript"
  ],

  "claudeCode.preferredLocation": "panel",
  "claudeCode.hideOnboarding": true,
  "editor.accessibilitySupport": "on",
  // Copilot Chat keys (chat.*) and the accessibility.signals.* sound-off keys: copilot-chat/config/settings.jsonc.

  "kilo-code.new.agentWorkStyle": "autonomous",
  "kilo-code.new.model.providerID": "openai",
  "kilo-code.new.model.modelID": "openai/gpt-5.6-sol-fast",
  "kilo-code.new.showTaskTimeline": false,
  "kilo-code.new.autoApprove.enabled": true,
  "kilo-code.new.attention.enabled": true,
  "kilo-code.new.attention.OSNotifications": false,
  "kilo-code.new.attention.notifications": true
}
