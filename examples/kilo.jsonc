{
  "$schema": "https://app.kilo.ai/config.json",
  "autoupdate": false,
  "instructions": [
    "<ABSOLUTE_PATH_TO_GLOBAL_AGENTS_MD>",
    "<ABSOLUTE_PATH_TO_RESPONSE_STYLE_MD>"
  ],
  "model": "lithosai/deepseek-ai/DeepSeek-V4.1-Flash-ultra-chat",
  "small_model": "openai/gpt-5.6-luna-fast",
  "subagent_model": "deepseek/deepseek-flash",
  "default_agent": "CTO (Recommended)",
  "subagent_depth": 2,
  "permission": {
    "TypeSafe_*": "deny",
    // Kilo's built-in doom-loop behavior only asks. Deny the detected repeat
    // so a model cannot continue a tool loop unattended.
    "doom_loop": "deny",
    "Peekaboo_*": "allow",
    "Peekaboo_browser": "deny",
    "external_directory": {
      "~/.claude/file-history/*": "allow",
      "~/.config/ponytail/*": "allow",
      "~/.claude/CLAUDE.md": "allow",
      "~/.codex/AGENTS.md": "allow",
      "~/.copilot/copilot-instructions.md": "allow",
      "<ABSOLUTE_PATH_TO_NODE_BIN>/*": "allow",
      "<ABSOLUTE_PATH_TO_NODE_MODULES>/*": "allow"
    }
  },
  "agent": {
    "general": {
      "model": "deepseek/deepseek-flash"
    },
    "explore": {
      "model": "openrouter/z-ai/glm-5.3-flash"
    },
    "orchestrator": {
      "hidden": true
    },
    "astra-engineering-lead": {
      "hidden": true
    },
    "Fable Engineering Lead": {
      "hidden": true
    },
    "Fable + Jev Engineering Lead": {
      "hidden": true
    },
    "Opus + Jev Engineering Lead": {
      "hidden": true
    },
    "Astra + Jev Engineering Lead": {
      "hidden": true
    },
    "Opus 5.5 High": {
      "hidden": true
    },
    "CTO (Recommended)": {
      "hidden": false,
      "model": "lithosai/deepseek-ai/DeepSeek-V4.1-Flash-ultra",
      "variant": "high"
    },
    "CTO + JEV": {
      "hidden": false,
      "model": "lithosai/deepseek-ai/DeepSeek-V4.1-Flash-ultra",
      "variant": "high"
    },
    "goal-clarifier": {
      "hidden": true,
      "mode": "subagent",
      "description": "Read-only prompt clarification",
      "steps": 2,
      "prompt": "Follow the clarification system instruction. Return only a faithful rewritten prompt or one essential clarification question. Never execute the user task.",
      "permission": {
        "*": "deny"
      }
    },
    "next-message-predictor": {
      "hidden": true,
      "mode": "subagent",
      "description": "Read-only prediction of the user's next chat message",
      "model": "lithosai/zai-org/GLM-5.3-Flash-ultra",
      "variant": "low",
      "steps": 1,
      "prompt": "Follow the prediction system instruction. Return only the predicted next user message on one line, or NONE. Never execute the task.",
      "permission": {
        "*": "deny"
      }
    },
    "CTO + SUBQ": {
      "hidden": false,
      "model": "lithosai/deepseek-ai/DeepSeek-V4.1-Flash-ultra",
      "variant": "high"
    }
  },
  "provider": {
    "lithosai": {
      "name": "LithosAI",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.lithosai.cloud/v1"
      },
      "models": {
        "zai-org/GLM-5.3-Flash-ultra-chat": {
          "name": "GLM 5.3 Flash Ultra Chat on LithosAI",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 1000000,
            "output": 32768
          },
          "options": {
            "reasoningEffort": "high"
          },
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "max": {
              "reasoningEffort": "max"
            },
            "medium": {
              "disabled": true
            },
            "minimal": {
              "disabled": true
            },
            "xhigh": {
              "disabled": true
            }
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "cost": {
            "input": 0.3,
            "output": 1,
            "cache_read": 0.06
          }
        },
        "deepseek-ai/DeepSeek-V4.1-Flash-ultra-chat": {
          "name": "DeepSeek V4.1 Flash Ultra Chat on LithosAI (0910)",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 1000000,
            "output": 32768
          },
          "options": {
            "reasoningEffort": "high"
          },
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "max": {
              "reasoningEffort": "max"
            },
            "medium": {
              "disabled": true
            },
            "minimal": {
              "disabled": true
            },
            "xhigh": {
              "disabled": true
            }
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "deepseek-ai/DeepSeek-V4.1-Flash-ultra": {
          "name": "DeepSeek V4.1 Flash Ultra on LithosAI (1017)",
          "cost": {
            "input": 0.35,
            "output": 1.4,
            "cache_read": 0.007
          },
          "reasoning": true,
          "options": {
            "reasoningEffort": "high"
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ]
          }
        },
        "zai-org/GLM-5.3-Flash-ultra": {
          "name": "GLM-5.3 Flash Ultra on LithosAI",
          "cost": {
            "input": 0.3,
            "output": 1,
            "cache_read": 0.06
          },
          "reasoning": true,
          "options": {
            "reasoningEffort": "high"
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ]
          }
        },
        "zai-org/GLM-5.3-ultra-chat": {
          "name": "GLM 5.3 Ultra Chat on LithosAI",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 1000000,
            "output": 32768
          },
          "options": {
            "reasoningEffort": "high"
          },
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "max": {
              "reasoningEffort": "max"
            },
            "medium": {
              "disabled": true
            },
            "minimal": {
              "disabled": true
            },
            "xhigh": {
              "disabled": true
            }
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    },
    "openrouter": {
      "models": {
        "z-ai/glm-5.3-flash": { "options": { "provider": { "sort": "throughput" } } }
      }
    },
    "deepseek": {
      "models": {
        "deepseek-flash": { "name": "DeepSeek V4.1 Flash API" },
        "deepseek-v4-pro": { "name": "DeepSeek V4 Pro API" }
      }
    },
    "primalabs": {
      "name": "PrimalLabs",
      "npm": "@ai-sdk/openai-compatible",
      "options": { "baseURL": "https://api.primalabs.ai/v1" },
      "models": {
        "primalabs-ai/MiMo-V2.6-Pro-RL": {
          "name": "MiMo V2.6 Pro RL (PrimalLabs)",
          "reasoning": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        },
        "primalabs-ai/DeepSeek-V4-Flash-0731": {
          "name": "DeepSeek V4 Flash 0731 (PrimalLabs)",
          "reasoning": true,
          "modalities": { "input": ["text"], "output": ["text"] }
        }
      }
    }
  },
  "mcp": {
    "TypeSafe": {
      "type": "local",
      "command": ["<ABSOLUTE_PATH_TO_NODE>", "<ABSOLUTE_PATH_TO_TYPESAFE_BRIDGE_MJS>"],
      "enabled": true,
      "timeout": 10000
    },
    "Claude Code Local": {
      "type": "local",
      "command": [
        "<ABSOLUTE_PATH_TO_NODE>",
        "<ABSOLUTE_PATH_TO_BRIDGE_MJS>",
        "<ABSOLUTE_PATH_TO_CLAUDE_EXECUTABLE>"
      ],
      "enabled": true,
      "timeout": 1800000
    },
    "Peekaboo": {
      "type": "local",
      "command": [
        "<ABSOLUTE_PATH_TO_PEEKABOO>",
        "mcp",
        "serve",
        "--no-remote",
        "--transport",
        "stdio"
      ],
      "enabled": true,
      "timeout": 600000
    }
  },
  "reasoning_display": "preview",
  "terminal_command_display": "collapsed",
  "subagent_variant_overrides": {
    "deepseek/deepseek-flash": "high"
  },
  "hide_prompt_training_models": true,
  "web_search": true
}
